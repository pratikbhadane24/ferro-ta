    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> BarBuilder: ...
    def __reduce__(self) -> tuple[object, tuple[str]]: ...
    def __copy__(self) -> BarBuilder: ...
    def __deepcopy__(self, memo: object) -> BarBuilder: ...

